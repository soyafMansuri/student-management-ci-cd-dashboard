# Copy to .env and fill in. NEVER commit .env. Placeholders only.

# ---- Docker image (the deploy script updates IMAGE_TAG automatically) ----
IMAGE_REPO=your-dockerhub-username/student-management-system
IMAGE_TAG=local

# ---- Host ports ----
# Use 80 on EC2. On a laptop use 8080 if port 80 is busy.
HTTP_PORT=80
DASHBOARD_PORT=8081

# ---- Monitoring dashboard ----
GITHUB_REPO=your-github-username/your-repository
# Fine-grained personal access token: ONLY this repository, permissions
# "Actions: Read-only" and "Metadata: Read-only". Nothing else.
GITHUB_TOKEN=
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me-to-a-long-random-password
DASHBOARD_REFRESH_SECONDS=20
